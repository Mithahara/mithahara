---
import Layout from '../../layouts/Layout.astro';
import '../../styles/sap.css';
import { odooApps, odooAppHref, formatPrice } from '../../data/odooApps.js';

const paid = odooApps.filter((app) => app.price > 0);
const free = odooApps.filter((app) => !app.price);

// Odoo's own category on each manifest, reduced to its top level -- the store
// shows "Accounting/Accounting" and "Accounting/Localizations" as one nav entry,
// so splitting them here would invent a distinction buyers never see.
const groups = new Map();
for (const app of odooApps) {
  const top = (app.category || 'Other').split('/')[0].trim();
  if (!groups.has(top)) groups.set(top, []);
  groups.get(top).push(app);
}
const sections = [...groups.entries()]
  .map(([name, apps]) => ({
    name,
    apps: apps.sort((a, b) => b.price - a.price || a.name.localeCompare(b.name)),
  }))
  .sort((a, b) => b.apps.length - a.apps.length || a.name.localeCompare(b.name));

const description =
  `All ${odooApps.length} Odoo apps built by Mithahara for Odoo 19 and 20 — ${paid.length} paid and ` +
  `${free.length} free modules covering compliance, accounting, access control, advertising and warehouse.`;
---

<Layout path="/odoo-apps" title="Odoo Apps" description={description}>
  <div class="sap">
    <nav class="sap-rail" aria-label="Breadcrumb">
      <div class="sap-wrap sap-rail-row">
        <p class="sap-crumb">Odoo Apps</p>
      </div>
    </nav>

    <header class="sap-hero">
      <div class="sap-wrap">
        <div class="log-row sap-tags"><span class="log-tag">Odoo 19 · 20</span></div>
        <h1>Odoo Apps</h1>
        <p class="sap-lead">
          {odooApps.length} modules on the Odoo App Store for Odoo 19 and Odoo 20. {free.length} are free and
          {' '}{paid.length} are paid, and most paid apps have a free counterpart that does one part of the job
          so you can try the approach before buying.
        </p>
      </div>
    </header>

    <section class="sap-band sap-tint" aria-label="At a glance">
      <div class="sap-wrap sap-tiles">
        <div class="sap-tile"><p class="sap-tile-n">{odooApps.length}</p><p class="sap-tile-l">apps live</p></div>
        <div class="sap-tile"><p class="sap-tile-n">{free.length}</p><p class="sap-tile-l">free</p></div>
        <div class="sap-tile"><p class="sap-tile-n">{paid.length}</p><p class="sap-tile-l">paid</p></div>
        <div class="sap-tile"><p class="sap-tile-n">{sections.length}</p><p class="sap-tile-l">categories</p></div>
      </div>
    </section>

    <section class="sap-band sap-blue">
      <div class="sap-wrap sap-prose">
        <p><strong>Before you install:</strong> third-party Odoo apps run on Odoo.sh and On-Premise
        databases only. They cannot be installed on Odoo Online (SaaS).</p>
      </div>
    </section>

    <section class="sap-band" aria-label="Find an app">
      <div class="sap-wrap sap-filterbar">
        <input
          type="search"
          id="sapSearch"
          class="sap-search"
          placeholder="Search by name or keyword…"
          aria-label="Search Odoo apps"
        />
        <div class="sap-pill-row" role="group" aria-label="Filter by category">
          <button type="button" class="sap-pill active" data-cat="all">All <span class="sap-count">{odooApps.length}</span></button>
          {sections.map((section) => (
            <button type="button" class="sap-pill" data-cat={section.name}>{section.name} <span class="sap-count">{section.apps.length}</span></button>
          ))}
        </div>
        <div class="sap-pill-row" role="group" aria-label="Filter by price">
          <button type="button" class="sap-pill active" data-price="all">All prices</button>
          <button type="button" class="sap-pill" data-price="free">Free</button>
          <button type="button" class="sap-pill" data-price="paid">Paid</button>
        </div>
        <p class="sap-filter-count"><span id="sapVisibleCount">{odooApps.length}</span> of {odooApps.length} apps</p>
      </div>
    </section>

    <section class="sap-band sap-tint" aria-label="All apps">
      <div class="sap-wrap">
        <div class="sap-rows" id="sapRows">
          {[...odooApps]
            .sort((a, b) => a.name.localeCompare(b.name))
            .map((app) => {
              const category = (app.category || 'Other').split('/')[0].trim();
              const search = [app.name, app.tech, app.tagline, app.summary].filter(Boolean).join(' ').toLowerCase();
              return (
                <a class="sap-app" href={odooAppHref(app)} data-category={category} data-free={app.price ? '0' : '1'} data-search={search}>
                  <span class="sap-app-head">
                    <span class="sap-app-name">{app.name}</span>
                    <span class={app.price ? 'sap-app-price' : 'sap-app-price free'}>{formatPrice(app)}</span>
                  </span>
                  <span class="sap-app-cat">{category}</span>
                  <span class="sap-app-tag">{app.tagline || app.summary}</span>
                  {app.hasVideo && <span class="sap-app-video">▶ Demo video</span>}
                </a>
              );
            })}
        </div>
        <p class="sap-filter-count" id="sapEmptyState" style="display:none; text-align:center; padding: 2rem 0;">
          No apps match that search — try a different word or clear the filters.
        </p>
      </div>
    </section>
  </div>

  <script>
    const rows = Array.from(document.querySelectorAll('.sap-app'));
    const searchInput = document.getElementById('sapSearch');
    const catPills = Array.from(document.querySelectorAll('[data-cat]'));
    const pricePills = Array.from(document.querySelectorAll('[data-price]'));
    const countEl = document.getElementById('sapVisibleCount');
    const emptyState = document.getElementById('sapEmptyState');
    let activeCat = 'all';
    let activePrice = 'all';

    function applyFilters() {
      const q = searchInput.value.trim().toLowerCase();
      let visible = 0;
      for (const row of rows) {
        const matchesCat = activeCat === 'all' || row.dataset.category === activeCat;
        const matchesPrice = activePrice === 'all' || row.dataset.free === (activePrice === 'free' ? '1' : '0');
        const matchesSearch = !q || (row.dataset.search || '').includes(q);
        const show = matchesCat && matchesPrice && matchesSearch;
        row.classList.toggle('sap-hidden', !show);
        if (show) visible++;
      }
      if (countEl) countEl.textContent = String(visible);
      if (emptyState) emptyState.style.display = visible === 0 ? 'block' : 'none';
    }

    if (searchInput) searchInput.addEventListener('input', applyFilters);
    catPills.forEach((btn) => btn.addEventListener('click', () => {
      catPills.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCat = btn.dataset.cat || 'all';
      applyFilters();
    }));
    pricePills.forEach((btn) => btn.addEventListener('click', () => {
      pricePills.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activePrice = btn.dataset.price || 'all';
      applyFilters();
    }));
  </script>
</Layout>
