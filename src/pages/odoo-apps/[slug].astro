---
import Layout from '../../layouts/Layout.astro';
import { odooApps, odooAppPages, odooAppHref, formatPrice, odooAppJsonLd } from '../../data/odooApps.js';
import { contacts } from '../../data/site.js';

export function getStaticPaths() {
  return odooAppPages.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

const { app } = Astro.props;

// Siblings in the same Odoo category, paid first. Related links are built from
// real category data rather than a hand-kept list, so they cannot drift out of
// date as the portfolio grows.
const topCategory = (app.category || '').split('/')[0].trim();
const related = odooApps
  .filter((other) =>
    other.tech !== app.tech &&
    (other.category || '').split('/')[0].trim() === topCategory)
  .sort((a, b) => b.price - a.price || a.name.localeCompare(b.name))
  .slice(0, 3);

// The meta description has to stand alone in a search result, so it leads with
// the tagline (written for a human) and falls back to the manifest summary
// (written for the store's substring matcher) only when there is no tagline.
// It ends with what a buyer weighs first - the versions covered and the price - so the
// tagline is the part that gets cut to fit, at a word boundary, never the suffix.
const metaSuffix = ` Odoo 19 & 20. ${app.price ? formatPrice(app) : 'Free'}.`;
const metaLead = (app.tagline || app.summary || '').replace(/[.\s]+$/, '');
const metaRoom = 158 - metaSuffix.length;
// A cut tagline should end where a clause ends, not mid-phrase: back up to the last dash, comma or
// colon when that keeps at least half of what fits, else to the last whole word.
const metaCut = (text, room) => {
  if (text.length + 1 <= room) return text;
  const head = text.slice(0, room - 1);
  const clause = Math.max(head.lastIndexOf(' - '), head.lastIndexOf(', '), head.lastIndexOf(': '), head.lastIndexOf(' — '));
  return clause > room / 2 ? head.slice(0, clause) : head.replace(/\s+\S*$/, '');
};
const metaDescription = metaCut(metaLead, metaRoom) + '.' + metaSuffix;

// The Odoo App Store renders a "Live Preview" button from the manifest's
// live_test_url and points it here, so this page has to actually offer one.
// mailto, because the site is static and has no form backend - the same
// mechanism /contact already uses, rather than new infrastructure.
const demoSubject = `Live demo request: ${app.name} (${app.tech})`;
const demoBody = `I would like a live demo of ${app.name}.\n\n`
  + `Odoo version: 19.0 (Community / Enterprise?)\n`
  + `Hosting: Odoo.sh / on-premise\n`
  + `What I want to see:\n`;
const demoMailto = `mailto:${contacts.email}?subject=${encodeURIComponent(demoSubject)}`
  + `&body=${encodeURIComponent(demoBody)}`;

// The page title is the strongest ranking surface here and it carried no
// product word at all - "Access Explorer | Mithahara" matches nobody's search.
// Google truncates around 60 characters including the " | Mithahara" suffix the
// layout appends (12), so the long names fall back to the shorter qualifier
// rather than being cut mid-phrase.
const pageTitle = `${app.name} for Odoo 19 & 20`.length + 12 <= 60
  ? `${app.name} for Odoo 19 & 20`
  : (`${app.name} for Odoo`.length + 12 <= 60 ? `${app.name} for Odoo` : app.name);

// Listing tiles when the listing has them; otherwise the four facts every buyer checks first.
const tiles = (app.tiles.length ? app.tiles : [
  { n: formatPrice(app), l: 'App Store price, per Odoo version' },
  { n: '19 · 20', l: 'Odoo versions, each sold on its own page' },
  { n: 'Odoo.sh', l: 'or On-Premise; not Odoo Online (SaaS)' },
  { n: app.version.split('.').slice(-3).join('.'), l: `version of ${app.tech}` },
]).slice(0, 6);

const jsonLd = odooAppJsonLd(app);
const faqLd = app.faq.length > 0 && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: app.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
const graph = [...(faqLd ? [faqLd] : []), ...(app.youtubeId
  ? [jsonLd, {
      '@context': 'https://schema.org',
      '@type': 'VideoObject',
      name: `${app.name} — demo`,
      description: app.tagline || app.summary,
      embedUrl: `https://www.youtube.com/embed/${app.youtubeId}`,
      thumbnailUrl: `https://i.ytimg.com/vi/${app.youtubeId}/maxresdefault.jpg`,
    }]
  : [jsonLd])];
---
<Layout path={`/odoo-apps/${app.slug}`} title={pageTitle} description={metaDescription}>
  <div class="sap">
    <nav class="sap-rail" aria-label="Page sections">
      <div class="sap-wrap sap-rail-row">
        <p class="sap-crumb"><a href="/odoo-apps">Odoo Apps</a> <span aria-hidden="true">›</span> {app.name}</p>
        <ul class="sap-tabs">
          <li><a href="#overview">Overview</a></li>
          {app.features.length > 0 && <li><a href="#how">How it works</a></li>}
          {app.scope.length > 0 && <li><a href="#limits">Limits</a></li>}
          {app.faq.length > 0 && <li><a href="#faq">Questions</a></li>}
          <li><a href="#requirements">Requirements</a></li>
        </ul>
      </div>
    </nav>

    <header class="sap-hero" id="overview">
      <div class={`sap-wrap sap-hero-grid${app.youtubeId ? '' : ' single'}`}>
        <div>
          <div class="log-row sap-tags">
            <span class="log-tag">Odoo 19 · 20</span>
            {app.category && <span class="log-tag">{app.category.split('/')[0]}</span>}
            <span class={app.price ? 'log-tag gold' : 'log-tag'}>{formatPrice(app)}</span>
          </div>
          <h1>{app.name}</h1>
          {app.tagline && <p class="sap-lead">{app.tagline}</p>}
          <div class="sap-actions">
            <a class="cta-button primary" href={app.storeUrl19} target="_blank" rel="noopener noreferrer">Get it for Odoo 19</a>
            <a class="cta-button secondary" href={app.storeUrl20} target="_blank" rel="noopener noreferrer">Get it for Odoo 20</a>
          </div>
          <p class="sap-note">
            <a href={demoMailto}>Request a live demo</a> · Odoo.sh or On-Premise only, not Odoo Online (SaaS).
          </p>
          {app.tech === 'mh_mcp_server' && (
            <p class="sap-note">Using Codex? <a href="/odoo-apps/mcp-server-for-odoo/codex">Set it up with the Codex plugin</a>.</p>
          )}
        </div>
        {app.youtubeId && (
          <div class="sap-frame sap-video">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${app.youtubeId}`}
              title={`${app.name} demo video`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        )}
      </div>
    </header>

    <section class="sap-band sap-tint" aria-label="At a glance">
      <div class="sap-wrap sap-tiles">
        {tiles.map((tile) => (
          <div class="sap-tile">
            <p class="sap-tile-n">{tile.n}</p>
            <p class="sap-tile-l">{tile.l}</p>
          </div>
        ))}
      </div>
    </section>

    {app.intro.length > 0 && (
      <section class="sap-band">
        <div class="sap-wrap sap-prose">
          {app.intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>
    )}

    {app.features.length > 0 && <h2 class="sap-sr" id="how">How it works</h2>}
    {app.features.map((feature, i) => (
      <section class={`sap-band${i % 2 === 0 ? '' : ' sap-tint'}`}>
        <div class={`sap-wrap sap-step${feature.images.length ? '' : ' single'}${i % 2 === 1 ? ' rev' : ''}`}>
          <div class="sap-prose">
            {feature.heading && <h3>{feature.heading}</h3>}
            {feature.use && (
              <p class="sap-use">
                <strong>Use it when</strong> {feature.use}
                {feature.mode && <span class="sap-chip">{feature.mode}</span>}
              </p>
            )}
            {feature.body.map((line) => <p>{line}</p>)}
            {feature.result && <p class="sap-callout">{feature.result}</p>}
            {feature.warn && <p class="sap-callout warn">{feature.warn}</p>}
          </div>
          {feature.images.length > 0 && (
            <div class="sap-shots">
              {feature.images.map((shot) => (
                <figure class="sap-frame">
                  <img
                    src={`/odoo-apps/${app.slug}/${shot}`}
                    alt={`${app.name}: ${feature.heading || 'screenshot'}`}
                    width={app.shotDims[shot]?.[0]}
                    height={app.shotDims[shot]?.[1]}
                    loading="lazy"
                  />
                </figure>
              ))}
            </div>
          )}
        </div>
      </section>
    ))}

    {app.screenshots.length > 0 && (
      <section class="sap-band">
        <div class="sap-wrap">
          <h2>Screenshots</h2>
          <div class="sap-gallery">
            {app.screenshots.map((shot) => (
              <figure class="sap-frame">
                <img
                  src={`/odoo-apps/${app.slug}/${shot}`}
                  alt={`${app.name} in Odoo — ${shot.split('/').pop().replace(/\.\w+$/, '').replace(/[_-]+/g, ' ')}`}
                  width={app.shotDims[shot]?.[0]}
                  height={app.shotDims[shot]?.[1]}
                  loading="lazy"
                />
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    {app.scope.length > 0 && (
      <section class="sap-band sap-blue" id="limits">
        <div class="sap-wrap sap-prose">
          <h2>What it does not do</h2>
          <ul class="sap-rules">
            {app.scope.map((line) => <li>{line}</li>)}
          </ul>
        </div>
      </section>
    )}

    {app.faq.length > 0 && (
      <section class="sap-band" id="faq">
        <div class="sap-wrap sap-prose">
          <h2>Questions buyers ask</h2>
          <div class="sap-faq">
            {app.faq.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="sap-band sap-tint" id="requirements">
      <div class="sap-wrap sap-prose">
        <h2>Requirements</h2>
        <ul class="sap-rules">
          <li>Odoo 19.0 or 20.0. The App Store sells each version separately, so buy the one that matches your database.</li>
          <li>
            <strong>Odoo.sh or On-Premise only.</strong> Third-party apps cannot be installed on
            Odoo Online (SaaS) databases. Check your hosting before buying.
          </li>
          {(app.paidDepends ?? []).map((dep) => (
            <li>
              <strong>Also requires {dep.name}</strong>
              {dep.price ? ` ($${dep.price.toFixed(0)})` : ''}, a separate paid app. The App Store
              price shown covers both; this app will not install without it.
            </li>
          ))}
          {app.requires.map((line) => <li>{line}</li>)}
          <li>Module <code>{app.tech}</code>, version {app.version}, licensed {app.license}.</li>
        </ul>
        {app.price > 0 && app.manifestPrice > 0 && app.manifestPrice < app.price && (
          <p class="sap-note">
            The Odoo App Store lists this app at {formatPrice(app)} because it requires a paid
            dependency; the module's own price is {formatPrice({ ...app, price: app.manifestPrice })}.
          </p>
        )}
      </div>
    </section>

    {related.length > 0 && (
      <section class="sap-band">
        <div class="sap-wrap">
          <h2>Related apps</h2>
          <div class="sap-related">
            {related.map((other) => (
              <a href={odooAppHref(other)}>
                <span class="sap-related-name">{other.name}</span>
                <span class="sap-related-price">{formatPrice(other)}</span>
                <span class="sap-related-tag">{other.tagline || other.summary}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="sap-band sap-deep">
      <div class="sap-wrap sap-closing">
        <h2>{app.name}</h2>
        <div class="sap-actions">
          <a class="cta-button sap-on-dark" href={app.storeUrl19} target="_blank" rel="noopener noreferrer">Get it for Odoo 19</a>
          <a class="cta-button sap-on-dark ghost" href={app.storeUrl20} target="_blank" rel="noopener noreferrer">Get it for Odoo 20</a>
        </div>
      </div>
    </section>
  </div>

  {graph.map((entry) => (
    <script type="application/ld+json" set:html={JSON.stringify(entry)} />
  ))}
</Layout>

<style is:global>
  /* SAP structure (rail, hero, ruled tiles, flat bands, media beside text) in the site's own
     tokens: sand ground, moss as the one action colour, gold for the price, Spectral headings,
     Archivo text and Space Mono labels. Nothing here introduces a colour or font the site lacks. */
  .sap {
    --tint: var(--sand-card);
    --moss-wash: color-mix(in srgb, var(--moss) 9%, var(--sand));
    --gold-wash: color-mix(in srgb, var(--gold) 16%, var(--sand));
    --rule: color-mix(in srgb, var(--ink) 35%, var(--sand));
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink);
    text-align: left;
  }
  .sap h1, .sap h2, .sap h3, .sap p, .sap ul, .sap figure { margin: 0; text-align: left; }
  .sap a { color: var(--moss-dark); }
  .sap-wrap { max-width: 1100px; margin: 0 auto; padding: 0 var(--space-sm); }
  .sap-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  /* rail: breadcrumb over a row of section tabs */
  .sap-rail { background: var(--tint); border-bottom: 1px solid var(--border-sand); }
  .sap-rail-row { padding-top: 0.75rem; }
  .sap-crumb { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-muted); line-height: 1.5; }
  .sap-crumb a { color: var(--text-muted); text-decoration: none; }
  .sap-crumb a:hover { color: var(--moss); }
  .sap-tabs { list-style: none; padding: 0; margin: 0; display: flex; gap: 1.5rem; overflow-x: auto; white-space: nowrap; }
  .sap-tabs a { display: block; padding: 0.7rem 0 0.6rem; font-size: 0.9rem; color: var(--text-muted); text-decoration: none; border-bottom: 2px solid transparent; }
  .sap-tabs a:hover { color: var(--moss); border-bottom-color: var(--moss); }

  /* hero */
  .sap-hero { padding: 3.5rem 0 3rem; }
  .sap-hero-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center; }
  .sap-tags { justify-content: flex-start; margin-bottom: 1rem; flex-wrap: wrap; }
  .sap h1 { font-size: 2.5rem; line-height: 1.12; font-weight: 700; margin-bottom: 1rem; }
  .sap-lead { font-size: 1.2rem; line-height: 1.6; color: var(--text-muted); max-width: 34em; }
  .sap-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .sap .cta-button { min-height: 44px; text-decoration: none; }
  .sap .cta-button.primary { color: var(--sand); }
  .sap a:focus-visible, .sap summary:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
  .sap-note { font-size: 0.9rem; line-height: 1.6; color: var(--text-muted); margin-top: 1rem; }

  /* media: natural size, framed, never enlarged */
  .sap-frame { border: 1px solid var(--border-sand); border-radius: 6px; overflow: hidden; background: #fff; }
  .sap-frame img { display: block; width: 100%; height: auto; }
  .sap-video { position: relative; aspect-ratio: 16 / 9; background: var(--ink); }
  .sap-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  /* bands */
  .sap-band { padding: 3.5rem 0; }
  .sap-tint { background: var(--tint); }
  .sap-blue { background: var(--moss-wash); }
  .sap-deep { background: var(--moss-dark); color: var(--sand); }
  .sap h2 { font-size: 1.9rem; line-height: 1.2; font-weight: 700; margin-bottom: 2rem; }
  .sap h3 { font-size: 1.3rem; line-height: 1.3; font-weight: 700; margin-bottom: 1rem; }
  .sap-wrap.sap-prose { max-width: 1100px; }
  .sap-wrap.sap-prose > * { max-width: 760px; }
  .sap-prose p + p { margin-top: 1rem; }

  /* stat tiles: ruled top over a big number */
  .sap-tiles { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem 1.5rem; padding-top: 0.5rem; padding-bottom: 0.5rem; }
  .sap-tile { border-top: 2px solid var(--moss); padding-top: 0.75rem; }
  .sap-tile-n { font-family: var(--font-serif); font-size: 2rem; line-height: 1.15; font-weight: 700; }
  .sap-tile-l { font-size: 0.85rem; line-height: 1.5; color: var(--text-muted); margin-top: 0.4rem; }

  /* steps: text beside its screenshot, alternating */
  .sap-step { display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: start; }
  .sap-step.single > .sap-prose { max-width: 760px; }
  .sap-use { font-size: 0.95rem; line-height: 1.6; color: var(--text-muted); margin-bottom: 1rem; }
  .sap-use strong { color: var(--ink); margin-right: 0.25rem; }
  .sap-chip { display: inline-block; margin-left: 0.5rem; padding: 0.1rem 0.5rem; background: var(--moss); color: var(--sand); font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; border-radius: 1px; }
  .sap-callout { margin-top: 1.25rem; padding: 0.75rem 1rem; border-left: 3px solid var(--moss); background: var(--moss-wash); font-size: 0.97rem; line-height: 1.6; border-radius: 0 6px 6px 0; }
  .sap-callout.warn { border-left-color: var(--gold-text); background: var(--gold-wash); }
  .sap-shots { display: grid; gap: 1rem; }
  .sap-gallery { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }

  /* hairline-ruled lists */
  .sap-rules { list-style: none; padding: 0; margin: 0; }
  .sap-rules li { padding: 1rem 0; border-top: 1px solid var(--rule); font-size: 1rem; line-height: 1.6; }
  .sap-rules li:last-child { border-bottom: 1px solid var(--rule); }
  .sap code { font-family: var(--font-mono); font-size: 0.85em; }

  /* FAQ */
  .sap-faq details { border-top: 1px solid var(--rule); }
  .sap-faq details:last-child { border-bottom: 1px solid var(--rule); }
  .sap-faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 1rem; align-items: center; min-height: 3.5rem; padding: 0.75rem 0; font-family: var(--font-serif); font-size: 1.2rem; line-height: 1.35; font-weight: 700; }
  .sap-faq summary::-webkit-details-marker { display: none; }
  .sap-faq summary::after { content: '+'; font-family: var(--font-mono); font-size: 1.4rem; color: var(--moss); flex: none; }
  .sap-faq details[open] summary::after { content: '\2212'; }
  .sap-faq details p { padding: 0 0 1.25rem; }

  /* related */
  .sap-related { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  .sap-related a { display: grid; gap: 0.4rem; padding: 1.25rem; border: 1px solid var(--border-sand); border-radius: 6px; color: var(--ink); background: var(--sand-card); text-decoration: none; }
  .sap-related a:hover { border-color: var(--moss); }
  .sap-related-name { font-family: var(--font-serif); font-size: 1.2rem; line-height: 1.3; font-weight: 700; }
  .sap-related-price { font-family: var(--font-mono); font-size: 0.75rem; color: var(--gold-text); }
  .sap-related-tag { font-size: 0.92rem; line-height: 1.5; color: var(--text-muted); }

  .sap-closing { display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem; }
  .sap-closing h2 { color: var(--sand); margin-bottom: 0; }
  .sap .cta-button.sap-on-dark { background: var(--sand); border: 1px solid var(--sand); color: var(--moss-dark); }
  .sap .cta-button.sap-on-dark:hover { background: #fff; }
  .sap .cta-button.sap-on-dark.ghost { background: transparent; color: var(--sand); }
  .sap .cta-button.sap-on-dark.ghost:hover { background: rgba(246, 241, 226, .14); }

  @media (min-width: 768px) {
    .sap-tiles { grid-template-columns: repeat(3, 1fr); }
    .sap-gallery { grid-template-columns: repeat(2, 1fr); }
    .sap-related { grid-template-columns: repeat(3, 1fr); }
    .sap-closing { flex-direction: row; align-items: center; justify-content: space-between; }
  }
  @media (min-width: 1024px) {
    .sap-hero-grid { grid-template-columns: 1fr 1fr; }
    .sap-hero-grid.single { grid-template-columns: 1fr; }
    .sap-step { grid-template-columns: 5fr 6fr; gap: 3.5rem; }
    .sap-step.rev { grid-template-columns: 6fr 5fr; }
    .sap-step.rev .sap-shots { order: -1; }
    .sap-step.single { grid-template-columns: 1fr; }
    .sap-shots { position: sticky; top: 1rem; }
    .sap-tiles { grid-template-columns: repeat(6, 1fr); }
  }
  @media (max-width: 767px) {
    .sap-band { padding: 2.5rem 0; }
    .sap-hero { padding: 2.5rem 0 2rem; }
    .sap h1 { font-size: 2rem; }
    .sap h2 { font-size: 1.6rem; }
  }
</style>
