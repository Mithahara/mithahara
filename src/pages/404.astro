---
import Layout from '../layouts/Layout.astro';
---
<Layout path="/404" title="Page Not Found" description="The page you're looking for doesn't exist.">
  <section class="page-section not-found-section">
    <div class="container">
      <h2 class="section-title">Page Not Found</h2>
      <p>That page doesn't exist — it may have moved or been removed.</p>
      <a class="cta-button primary" href="/">Back to Home</a>
    </div>
  </section>
</Layout>
