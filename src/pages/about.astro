---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import { apps } from '../data/site.js';
import { odooApps } from '../data/odooApps.js';

const chromeCount = apps.filter((app) => app.platform === 'Chrome').length;
const odooCount = odooApps.length;
---
<Layout
  path="/about"
  title="About"
  description="Mithahara is a parent brand behind Ahar's vegetarian food in Panchkula, the upcoming Man'sahara venture, and a set of Odoo apps and Chrome extensions."
>
  <section>
    <div class="container">
      <h2 class="section-title">About Mithahara</h2>
      <p class="venture-description">
        The name borrows from <em>mitahara</em> — moderate, balanced eating, one of yoga's classical
        disciplines. We're building sustainable ways to hit your daily dietary goals through food
        ventures and the software that supports them. It started as a single food venture and has
        grown into a small parent brand with three active threads.
      </p>
    </div>
  </section>

  <section class="sand-band">
    <div class="container">
      <div class="ventures-grid">
        <a class="venture-card-lg" href="/ahar">
          <div class="venture-card-head">
            <h3>Ahar</h3>
            <span class="log-tag">Active</span>
          </div>
          <p>
            Mithahara's vegetarian food venture, opened 11th January 2025 in Sector 14, Panchkula.
            Fresh idlis, appams, uttapams, and paranthas, served daily 7 AM–2:30 PM on eco-friendly
            ware. Also takes bulk orders for offices, events, and gatherings.
          </p>
          <span class="learn-more">Explore Ahar →</span>
        </a>
        <a class="venture-card-lg upcoming" href="/mansahara">
          <div class="venture-card-head">
            <h3>Man'sahara</h3>
            <span class="log-tag gold">Coming Soon</span>
          </div>
          <p>
            Mithahara's upcoming non-vegetarian venture, built on the same premise as Ahar —
            sustainable, healthy, hygienic daily nutrition — for people who eat meat. It's in the
            works.
          </p>
          <span class="learn-more">See what's coming →</span>
        </a>
        <a class="venture-card-lg" href="/apps">
          <div class="venture-card-head">
            <h3>Apps</h3>
            <span class="log-tag">Shipping</span>
          </div>
          <p>
            Alongside the food ventures, Mithahara ships {odooCount} Odoo apps and {chromeCount} Chrome
            extensions — built and shipped at a fast pace.
          </p>
          <span class="learn-more">Browse the apps →</span>
        </a>
      </div>
    </div>
  </section>

  <CtaBand
    title="Questions About Any of It?"
    description="Ahar orders, Man'sahara updates, or one of the apps — the same inbox reaches the team."
    ctaLabel="Contact Us"
    ctaHref="/contact"
  />
</Layout>
