---
import Layout from '../layouts/Layout.astro';
---
<Layout path="/">
  <section class="hero-section">
    <div class="hero-container" style="display: block; text-align: center;">
      <span class="log-tag">log/000 — Panchkula</span>
      <h1 class="hero-title">Mithahara</h1>
      <p class="hero-subtitle">Healthy, Hygienic &amp; Sustainable, Every Day</p>
      <p class="hero-description" style="max-width: 560px; margin: 0 auto 2rem;">Building sustainable ways to hit your daily dietary goals — through food ventures and the software that supports them.</p>
      <div class="hero-actions" style="justify-content: center;">
        <a class="cta-button primary" href="/ahar">Ahar</a>
        <a class="cta-button secondary" href="/mansahara">Man'sahara</a>
        <a class="cta-button secondary" href="/apps">Apps</a>
      </div>
    </div>
  </section>

  <section class="ventures-section">
    <div class="container">
      <h2 class="section-title">Three Ways In</h2>
      <p class="venture-tagline">One Parent Brand, A Few Ways to Live It</p>
      <div class="ventures-grid">
        <a class="venture-card-lg" href="/ahar">
          <div class="venture-card-head">
            <h3>Ahar</h3>
            <span class="log-tag">Active</span>
          </div>
          <p>Healthy, hygienic, sustainable vegetarian food — served fresh every day in Panchkula, 7:00–14:30.</p>
          <span class="learn-more">Explore Ahar →</span>
        </a>
        <a class="venture-card-lg upcoming" href="/mansahara">
          <div class="venture-card-head">
            <h3>Man'sahara</h3>
            <span class="log-tag gold">Coming Soon</span>
          </div>
          <p>Same mission as Ahar, extended to non-vegetarian food. We're getting it ready — check back soon.</p>
          <span class="learn-more">See what's coming →</span>
        </a>
        <a class="venture-card-lg" href="/apps">
          <div class="venture-card-head">
            <h3>Apps</h3>
            <span class="log-tag">Shipping</span>
          </div>
          <p>Chrome extensions and Odoo apps we build and ship at a fast pace.</p>
          <span class="learn-more">Browse the apps →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <h2 class="cta-title">One Mission, A Few Ways to Live It</h2>
        <p class="cta-description">Explore Ahar, look out for Man'sahara, and power your workflow with our apps</p>
        <a class="cta-button large primary" href="/contact">
          Contact Us
        </a>
      </div>
    </div>
  </section>
</Layout>
