---
import Layout from '../layouts/Layout.astro';
const lastUpdated = 'August 2026';
---
<Layout
  path="/terms-conditions"
  title="Terms & Conditions"
  description="Terms and conditions for ordering from Ahar and using Mithahara's apps."
>
  <section class="page-section">
    <div class="container">
      <h2 class="section-title">Terms & Conditions</h2>
      <p class="page-meta">Last updated: {lastUpdated}</p>

      <h3>Ahar orders</h3>
      <p>
        Orders, including bulk orders for offices, events, and gatherings, are confirmed once
        agreed over email or WhatsApp. Menu items and prices are subject to change and may vary
        based on seasonal availability. Regular service runs 7 AM – 2:30 PM daily, subject to
        occasional seasonal breaks.
      </p>

      <h3>Apps</h3>
      <p>
        BYOK Gateway, Community Cash Reconciler, and Multi-Currency Rounding are distributed
        through the Odoo App Store; ClipMark is distributed through the Chrome Web Store. Use of
        each app is subject to that store's terms in addition to these.
      </p>

      <h3>Contact</h3>
      <p>
        For questions about an order or an app, reach us at{' '}
        <a href="mailto:founder@mithahara.com">founder@mithahara.com</a>.
      </p>
    </div>
  </section>
</Layout>
