---
import Layout from '../../layouts/Layout.astro';
import AppsGrid from '../../components/AppsGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<Layout
  path="/apps"
  title="Apps"
  description="Chrome extensions and Odoo apps built at Mithahara — BYOK Gateway, Community Cash Reconciler, Multi-Currency Rounding, Meta Odoo Connector, ClipMark, and Duckout."
>
  <section class="venture-section apps-section" id="apps">
    <div class="container">
      <div class="log-row"><span class="log-tag">log/003 — Shipping</span></div>
      <h2 class="section-title">Apps</h2>
      <p class="venture-tagline">Chrome Extensions &amp; Odoo Apps, Built at Mithahara</p>
      <p class="venture-description">
        Alongside our food ventures, we build and ship Chrome extensions and Odoo apps at a fast pace.
        Here's what's live so far.
      </p>
      <AppsGrid />
    </div>
  </section>

  <CtaBand
    title="Browse the Full Odoo Catalog"
    description="Every module we ship lives on the Odoo Apps Store. (This link is an affiliate link.)"
    ctaLabel="Explore Odoo Apps"
    ctaHref="https://www.odoo.com/r/aff-mithahara"
    ctaExternal
  />
</Layout>
