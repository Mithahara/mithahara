---
import Layout from '../../layouts/Layout.astro';
import { apps, appSoftwareApplicationJsonLd, contacts } from '../../data/site.js';
import { odooApps } from '../../data/odooApps.js';

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

const { app } = Astro.props;
const jsonLd = appSoftwareApplicationJsonLd(app);

// Four Odoo apps predate /odoo-apps and keep their page here. Their demo videos live in
// the generated data like every other app's, so look the id up by slug rather than
// leaving these four as the only pages that publish a video and never show it.
const generated = odooApps.find((o) => o.slug === app.slug);
const youtubeId = generated?.youtubeId ?? null;
const videoJsonLd = youtubeId && {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: `${app.name} — demo`,
  description: app.description,
  embedUrl: `https://www.youtube.com/embed/${youtubeId}`,
  thumbnailUrl: `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`,
};
const ctaLabel = app.platform === 'Chrome' ? 'View on Chrome Web Store' : 'View on Odoo Apps';

// These four Odoo apps keep their pre-/odoo-apps URL, and the store's Live
// Preview button (live_test_url) redirects here - so the demo offer has to
// exist on this page too, or the button is a hollow claim on four paid apps.
// Gated on `generated`, which is only set for the Odoo ones: a Chrome
// extension must not offer an Odoo demo.
const demoSubject = generated ? `Live demo request: ${app.name} (${generated.tech})` : '';
const demoBody = generated
  ? `I would like a live demo of ${app.name}.\n\nOdoo version: 19.0 (Community / Enterprise?)\nHosting: Odoo.sh / on-premise\nWhat I want to see:\n`
  : '';
const demoMailto = generated
  ? `mailto:${contacts.email}?subject=${encodeURIComponent(demoSubject)}&body=${encodeURIComponent(demoBody)}`
  : '';
---
<Layout
  path={`/apps/${app.slug}`}
  title={app.name}
  description={app.description}
>
  <section class="page-section app-detail">
    <div class="container">
      <div class="log-row"><span class="log-tag">{app.platform}</span>{app.price && <span class="log-tag gold">{app.price}</span>}</div>
      <h2 class="section-title">{app.name}</h2>
      <p class="venture-tagline">{app.tagline}</p>

      <div class="hero-actions" style="justify-content: center;">
        <a class="cta-button primary" href={app.url} target="_blank" rel="noopener noreferrer">{ctaLabel}</a>
        {app.webUrl && (
          <a class="cta-button secondary" href={app.webUrl} target="_blank" rel="noopener noreferrer">Open Web App</a>
        )}
        {app.privacyUrl && (
          <a class="cta-button secondary" href={app.privacyUrl} target="_blank" rel="noopener noreferrer">Privacy Policy</a>
        )}
        {generated && (
          <a class="cta-button secondary" href={demoMailto}>Request a live demo</a>
        )}
      </div>
      {generated && (
        <p class="demo-note">
          {generated.youtubeId
            ? `The video below shows ${app.name} running on a real Odoo 19 database. Want it driven against your own data, or a question answered first? Ask and we will set up a session.`
            : `Want to see ${app.name} running against your own data before you buy? Ask and we will set up a session.`}
        </p>
      )}

      {youtubeId && (
        <div class="video-frame">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
            title={`${app.name} demo video`}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      )}

      {(app.body ?? [app.description]).map((paragraph) => (
        <p>{paragraph}</p>
      ))}

      {app.features && (
        <>
          <h3>What you get</h3>
          <ul class="feature-list">
            {app.features.map((feature) => <li>{feature}</li>)}
          </ul>
        </>
      )}

      {app.screenshots && (
        <div class="screenshot-grid">
          {app.screenshots.map((shot) => (
            <figure class="screenshot-card">
              <img src={shot.src} alt={shot.alt} loading="lazy" />
              <figcaption>{shot.alt}</figcaption>
            </figure>
          ))}
        </div>
      )}

      <p style="text-align: center; margin-top: 2rem;">
        <a href="/apps">← Back to Apps</a>
      </p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {videoJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(videoJsonLd)} />
  )}
</Layout>

<style>
  .demo-note { max-width: 62ch; margin: 0.9rem auto 0; text-align: center; font-size: 0.92rem; opacity: 0.75; }

  .video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    margin: 2rem auto;
    max-width: 44rem;
    border-radius: 8px;
    overflow: hidden;
    background: var(--ink);
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
