---
const links = [
  { href: '/ahar', label: "Ahar" },
  { href: '/mansahara', label: "Man'sahara" },
  { href: '/apps', label: 'Apps' },
  { href: '/odoo-apps', label: 'Odoo Apps' },
  { href: '/contact', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---
<nav class="navbar">
  <div class="nav-container">
    <a class="nav-title" href="/">
      <img src="/favicon.svg" alt="" width="28" height="28" />
      Mithahara
    </a>
    <button class="nav-toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
      <span class="hamburger"><span></span><span></span><span></span></span>
    </button>
    <ul class="nav-links" id="nav-links">
      {links.map((link) => (
        <li><a href={link.href} class={currentPath.startsWith(link.href) ? 'active' : ''}>{link.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const navLinks = document.getElementById('nav-links');
  toggle?.addEventListener('click', () => {
    const isOpen = navLinks?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
  });
</script>
